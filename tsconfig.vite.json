{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/fe/**/*.ts",
    "src/fe/**/*.tsx",
    "src/types/**/*.ts",
    "tests/fe/**/*.ts",
    "tests/fe/**/*.tsx",
    "vite.config.ts"
  ]
}
